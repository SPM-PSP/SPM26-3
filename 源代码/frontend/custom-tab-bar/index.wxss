.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  background: #FFF;
  display: flex;
  line-height: 1.2;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #e6e6e6;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-item .image {
  width: 22px;
  height: 22px;
}
.bulge {
  background-color: rgb(255, 255, 255);
  position: relative;
}
.bulge .tab-bar-bulge{
  position: absolute;
  z-index: 1;
  width: 64px;
  height: 64px;
  top: -20px;
  border-radius: 50%;
  border-top: 1px solid #e6e6e6;
  background-color: rgb(186, 233, 253);
}
.bulge .image{
  position: relative; 
  width: 50px;
  height: 50px;
  top: -11px;
  z-index: 10;
  left: 48%;
  transform: translateX(-75%);
}
.bulge .tab-bar-view{
  position: relative;
  bottom: -16px;
  margin-top: 4px;
}

.tab-bar-item .tab-bar-view {
  font-size: 12px;
  margin-top: 4px;
}