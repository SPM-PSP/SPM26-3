page {
  margin: 0;
  padding: 0;
  background: #f8f6ff;
  box-sizing: border-box;
}
.login-page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部渐变头部 - 修复重复、高度、圆角、层级问题 */
.header-section {
  width: 100%;
  height: 46vh;
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 50%, #fbc2eb 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 80rpx 80rpx;
}
/* 背景装饰圆点 */
.header-section::before,
.header-section::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  z-index: 0;
}
.header-section::before {
  width: 200rpx;
  height: 200rpx;
  top: 10%;
  left: 10%;
}
.header-section::after {
  width: 260rpx;
  height: 260rpx;
  top: 5%;
  right: 5%;
}
.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}
.logo {
  width: 120rpx;
  height: 120rpx;
}
.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 30rpx;
  position: relative;
  z-index: 1;
}
.app-en-name {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

/* 中间介绍文字 */
.intro-section {
  padding: 50rpx 40rpx 30rpx;
  text-align: center;
}
.intro-section .title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2d2d44;
  margin-bottom: 20rpx;
}
.intro-section .desc {
  font-size: 28rpx;
  color: #888;
  line-height: 1.6;
}

/* 搭子标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  padding: 0 30rpx 40rpx;
}
.tag-item {
  background: #edf5ff;
  color: #1e5f9b;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

/* 登录按钮和协议 */
.action-section {
  padding: 0 40rpx 40rpx;
  margin-top: auto;
}
/* 按钮修复：去除默认样式 */
button {
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.5 !important;
}
.login-btn {
  width: 100%;
  background: linear-gradient(90deg, #90bafd 0%, #9dddfa 50%, #fca3e3 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(161, 196, 253, 0.3);
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}
.wechat-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 18rpx;
}

/* 勾选协议 */
.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 6rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background: linear-gradient(135deg, #a1c4fd 0%, #fbc2eb 100%);
  border-color: transparent;
  position: relative;
}
.checkbox.checked::after {
  content: "✓";
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}
.agree-txt {
  font-size: 24rpx;
  color: #64748b;
}
.link {
  font-size: 24rpx;
  color: #a1c4fd;
  margin: 0 4rpx;
}

/* 底部数据统计 */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 40rpx 40rpx;
  margin-top: 100rpx;
}
.stat-item {
  text-align: center;
}
.stat-item .num {
  font-size: 40rpx;
  font-weight: bold;
  color: #5e97d8;
}
.stat-item .text {
  font-size: 26rpx;
  color: #888;
  margin-top: 10rpx;
}