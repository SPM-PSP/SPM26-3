page {
  background-color: #F7F8FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  box-sizing: border-box;
}

.page-container {
  width: 100%;
  overflow-x: hidden;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 顶部导航 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 0;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
}

.publish-btn {
  background: linear-gradient(135deg, #A7D8FF, #FFD6E8);
  color: white;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 搜索栏 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #F3F4F6;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.search-icon {
  color: #9CA3AF;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 32rpx;
}

/* 分类标签 */
.category-tabs {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 24rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #6B7280;
  background-color: #F3F4F6;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #A7D8FF, #FFD6E8);
  color: white;
}

/* 动态卡片 */
.dynamic-list {
  margin-bottom: 32rpx;
}

.dynamic-card {
  background-color: white;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-banner {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background-color: #f3f4f6;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.travel-banner {
  background-color: #E6F4FF;
}

.study-banner {
  background-color: #FFEBF2;
}

.banner-icon {
  font-size: 128rpx;
}

/* 卡片文字区 */
.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #1F2937;
  padding: 22rpx 32rpx 0 32rpx;
  line-height: 46rpx;
}

.card-content-wrap {
  padding: 10rpx 32rpx 16rpx 32rpx;
  overflow: hidden;
}

.card-content {
  display: -webkit-box;
  font-size: 27rpx;
  color: #6B7280;
  line-height: 38rpx;
  max-height: 76rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  padding: 0 32rpx 18rpx 32rpx;
}

.author-avatar {
  width: 42rpx;
  height: 42rpx;
  min-width: 42rpx;
  border-radius: 50%;
  background-color: #EC4899;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 42rpx;
  margin-right: 12rpx;
}

.author-name {
  font-size: 24rpx;
  line-height: 42rpx;
  font-weight: 500;
  color: #1F2937;
}

.publish-time {
  font-size: 22rpx;
  line-height: 42rpx;
  color: #6B7280;
  margin-left: 8rpx;
}

.divider {
  height: 2rpx;
  background-color: #E5E7EB;
  margin: 0 32rpx 18rpx;
}

/* 互动栏 */
.stats-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;

  padding: 0 24rpx 24rpx 24rpx;

  gap: 18rpx;
}
.stat-item {
  width: 68rpx;
  display: flex;
  align-items: center;
}

.like-icon,
.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.stat-text {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 34rpx
}

/* 空数据提示 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 128rpx;
  color: #D1D5DB;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #9CA3AF;
}
/* 单独调整卡片正文和互动栏位置，头像昵称不动 */
.card-title {
  padding-left: 32rpx;
  padding-right: 24rpx;
}

.card-content-wrap {
  padding-left: 34rpx;
  padding-right: 24rpx;
}

.stats-bar {
  padding-left: 36rpx;
  padding-right: 24rpx;
}

.divider {
  margin-left: 30rpx;
  margin-right: 24rpx;
}

