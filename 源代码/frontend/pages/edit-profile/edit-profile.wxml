<view class="container">

<!-- 头像上传区域 -->
<view class="avatar-section" bindtap="chooseAvatar">
  <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
  <text class="tip">点击更换头像</text>
</view>

<!-- 表单卡片 -->
<view class="form-card">
  <!-- 昵称 -->
  <view class="form-item">
    <text class="label">昵称</text>
    <input class="input" placeholder="请输入昵称" value="{{userInfo.nickname}}" bindinput="setNickname" />
  </view>

  <!-- 简介 -->
  <view class="form-item">
    <text class="label">简介</text>
    <input class="input" placeholder="请输入个性签名" value="{{userInfo.bio}}" bindinput="setBio" />
  </view>

  <!-- 学校 -->
  <view class="form-item">
    <text class="label">学校</text>
    <input class="input" placeholder="请输入学校名称" value="{{userInfo.school}}" bindinput="setSchool" />
  </view>

  <!-- 年级 -->
  <view class="form-item">
    <text class="label">年级</text>
    <picker mode="selector" range="{{gradeOptions}}" bindchange="onGradeChange">
      <view class="picker-value">{{userInfo.grade || '请选择年级'}}</view>
    </picker>
  </view>

  <!-- 性别 -->
  <view class="form-item">
    <text class="label">性别</text>
    <view class="gender-group">
      <view class="gender-option {{userInfo.gender === 1 ? 'active' : ''}}" bindtap="setGender" data-gender="1">男</view>
      <view class="gender-option {{userInfo.gender === 2 ? 'active' : ''}}" bindtap="setGender" data-gender="2">女</view>
      <view class="gender-option {{userInfo.gender === 0 ? 'active' : ''}}" bindtap="setGender" data-gender="0">保密</view>
    </view>
  </view>

  <!-- 兴趣标签 -->
  <view class="form-item">
    <text class="label">兴趣标签（可多选）</text>
    <view class="tags-group">
      <view wx:for="{{allTags}}" wx:key="id" class="tag {{item.active ? 'active' : ''}}" bindtap="toggleTag" data-index="{{index}}">{{item.name}}</view>
    </view>
  </view>
</view>

<!-- 保存按钮 -->
<button class="save-btn" bindtap="saveProfile">保存修改</button>

</view>