/** myApplications.wxss **/

view, text, scroll-view { box-sizing: border-box; }

.page-wrapper {
  display: flex; flex-direction: column; height: 100vh; width: 100vw;
  background-color: #f8faff; overflow: hidden;
}

/* 顶部 Tab */
.header-tab {
  background: linear-gradient(180deg, #6a5eff 0%, #8c7eff 100%);
  width: 100%; position: relative; z-index: 500; margin-top: -1rpx;
}
.tab-box { display: flex; height: 100rpx; align-items: center; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: rgba(255, 255, 255, 0.7); font-size: 28rpx; }
.tab-item.active { color: #ffffff; font-weight: bold; font-size: 30rpx; }
.indicator { width: 40rpx; height: 6rpx; background: #ffffff; border-radius: 10rpx; margin-top: 8rpx; opacity: 0; transition: all 0.3s; }
.tab-item.active .indicator { opacity: 1; width: 60rpx; }

/* 下拉筛选器 */
.dropdown-container {
  position: relative;
  background: #fff;
  z-index: 400;
  border-bottom: 1rpx solid #eee;
}
.dropdown-trigger {
  height: 80rpx; display: flex; align-items: center; justify-content: center;
}
.select-txt { font-size: 26rpx; color: #333; font-weight: 500; max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.arrow { font-size: 20rpx; margin-left: 10rpx; color: #ccc; transition: 0.3s; }
.arrow.open { transform: rotate(180deg); color: #6a5eff; }

.dropdown-menu {
  position: absolute; top: 80rpx; left: 0; width: 100%;
  background: #fff; max-height: 0; overflow: hidden; transition: 0.3s;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1); border-radius: 0 0 30rpx 30rpx;
}
.dropdown-menu.show { max-height: 600rpx; padding-bottom: 20rpx; }
.menu-item { padding: 30rpx 40rpx; font-size: 26rpx; color: #666; border-bottom: 1rpx solid #f8f8f8; }
.menu-item.active { color: #6a5eff; font-weight: bold; background: #f9fbff; }

.mask {
  position: fixed; top: 180rpx; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: -1;
}

/* 列表内容 */
.content-scroll { flex: 1; width: 100%; }
.list-padding { padding: 30rpx; }
.apply-card {
  background: #ffffff; border-radius: 32rpx; padding: 30rpx; margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(106,94,255,0.05); border: 1rpx solid #ebeef5;
}
.card-header { display: flex; align-items: center; margin-bottom: 24rpx; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #f5f5f5; border: 2rpx solid #f0f0f0; }
.user-info { flex: 1; margin-left: 20rpx; }
.username { font-size: 28rpx; font-weight: bold; color: #333; }
.time { font-size: 22rpx; color: #bbb; }
.status-tag { font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 20rpx; }
.status-tag.pending { background: #fff7ed; color: #faad14; }
.status-tag.accepted { background: #f0fdf4; color: #52c41a; }
.status-tag.rejected { background: #fef2f2; color: #ff4d4f; }

.card-body { background-color: #f9fbff; border-radius: 24rpx; padding: 24rpx; margin-top: 10rpx; }
.label { font-size: 20rpx; color: #b0b0b0; display: block; margin-bottom: 6rpx; }
.post-title { font-size: 26rpx; font-weight: bold; color: #444; line-height: 1.4; }
.message-box { font-size: 26rpx; color: #666; border-top: 1rpx solid rgba(220,223,230,0.5); padding-top: 12rpx; font-style: italic; }

.card-footer { margin-top: 25rpx; display: flex; justify-content: flex-end; gap: 20rpx; }
.btn-cancel { padding: 12rpx 40rpx; border-radius: 40rpx; border: 1rpx solid #eee; color: #999; font-size: 24rpx; }
.btn { padding: 14rpx 40rpx; border-radius: 40rpx; font-size: 26rpx; font-weight: bold; margin: 0 !important; }
.btn-reject { background: #f5f5f5; color: #999; }
.btn-accept { background: linear-gradient(135deg, #6a5eff 0%, #8c7eff 100%); color: white; }

.empty-box { text-align: center; padding-top: 250rpx; display: flex; flex-direction: column; align-items: center; }
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; opacity: 0.3; }
.empty-text { color: #ccc; font-size: 26rpx; }