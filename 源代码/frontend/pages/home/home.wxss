/* pages/home/home.wxss */

page { background: #fcfcff; }
.home-root { width: 100%; display: block; overflow-x: hidden; }

/* 1. 顶部渐变 Header */
.header-banner {
  width: 100%;
  background: linear-gradient(135deg, #6a5eff 0%, #a286ff 50%, #ffbb77 100%);
  padding: 20rpx 40rpx 80rpx;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  color: white;
}

.header-top { display: flex; justify-content: space-between; align-items: flex-end; }
.app-title-row { font-size: 56rpx; font-weight: bold; margin-top: 10rpx; }
.bell-btn { width: 90rpx; height: 90rpx; background: rgba(255, 255, 255, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; }
.unread-dot { position: absolute; top: 22rpx; right: 22rpx; width: 14rpx; height: 14rpx; background: #ffcf00; border-radius: 50%; border: 3rpx solid #fff; }

.search-wrap { width: 100%; margin-top: 30rpx; }
.search-bar { background: rgba(255, 255, 255, 0.25); height: 88rpx; border-radius: 44rpx; display: flex; align-items: center; padding: 0 40rpx; }
.search-bar input { flex: 1; margin-left: 15rpx; color: #fff; font-size: 28rpx; }
.ph-style { color: rgba(255,255,255,0.6); }

/* 2. 主体布局 */
.main-content { padding: 0 0 40rpx; }
.section-head { display: flex; align-items: center; padding: 30rpx 40rpx 15rpx; }
.section-head .icon { font-size: 40rpx; margin-right: 15rpx; }
.section-head .title { font-size: 34rpx; font-weight: bold; color: #333; }

/* 3. 攻略 Swiper */
.guide-swiper { height: 240rpx; width: 100%; }
.guide-card { height: 180rpx; margin: 0 15rpx; border-radius: 35rpx; padding: 30rpx 40rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.02); }
.g-title { font-size: 28rpx; font-weight: bold; color: #333; }
.g-tag { font-size: 22rpx; color: #888; }
.g-emoji { font-size: 80rpx; opacity: 0.9; }

/* 4. 广场 Banner */
.square-banner { margin: 15rpx 35rpx 30rpx; height: 160rpx; background: linear-gradient(90deg, #8a74f9 0%, #9d85ff 100%); border-radius: 30rpx; padding: 0 40rpx; display: flex; justify-content: space-between; align-items: center; color: #fff; box-shadow: 0 10rpx 25rpx rgba(124, 102, 245, 0.15); }
.sq-btn { background: #fff; color: #7c66f5; padding: 12rpx 35rpx; border-radius: 40rpx; font-size: 22rpx; font-weight: bold; }

/* 5. 帖子卡片样式 (关键点) */
.post-list { padding: 0 30rpx; }
.post-card { background: #fff; border-radius: 35rpx; padding: 35rpx; margin-bottom: 25rpx; box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.03); }
.u-row { display: flex; align-items: center; margin-bottom: 20rpx; }

/* 头像图片样式 */
.u-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #eee;
  flex-shrink: 0;
}

.u-meta { margin-left: 20rpx; }
.u-name { font-weight: bold; font-size: 30rpx; color: #333; }
.u-tag { background: #f4f2ff; color: #6a5eff; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 10rpx; margin-top: 6rpx; display: inline-block; }
.p-title { font-size: 34rpx; font-weight: 800; color: #1a1a1a; margin-bottom: 15rpx; }
.p-details { font-size: 26rpx; color: #777; line-height: 1.8; margin-bottom: 20rpx; }
.needed-num { color: #ff5e62; font-weight: bold; }
.p-labels { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pill { background: #f5f6fa; color: #999; padding: 6rpx 20rpx; border-radius: 30rpx; font-size: 22rpx; }

/* ... 保持原有代码不变 ... */

/* [新增] 帖子图片容器 */
.p-image-wrap {
  width: 100%;
  height: 320rpx; /* 固定高度，您可以根据需要调整 */
  margin-bottom: 25rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #f1f5f9;
}

/* [新增] 帖子主图样式 */
.p-main-image {
  width: 100%;
  height: 100%;
  transition: opacity 0.3s;
}

/* 优化细节：当点击详情返回时，图片会有更好的视觉过渡 */
.post-card:active .p-main-image {
  opacity: 0.9;
}

