page {
  background-color: #f8f9ff;
}
.container {
  padding: 80rpx 30rpx;
}

/* 提示 */
.tip-box {
  margin-bottom: 50rpx;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 12rpx;
  margin-left: 50rpx;
}
.desc {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 表单 */
.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 80rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(161, 196, 253, 0.1);
}
.form-item {
  margin-bottom: 40rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 16rpx;
}
.input {
  height: 80rpx;
  padding: 0 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
  font-size: 30rpx;
}
.input:focus {
  border-color: #a1c4fd;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #86b4fd 0%, #a6e1fc 50%, #f898dd 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 18rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(161, 196, 253, 0.25);
}
button::after {
  border: none;
}

.submit-btn.btn-disabled {
  background: #ccc;
  box-shadow: none;
}

.status-tip {
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  text-align: center;
}
.status-text {
  font-size: 28rpx;
  color: #666;
}
.upload-area {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  overflow: hidden;
}
.upload-image {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  text-align: center;
}
.plus {
  font-size: 60rpx;
  color: #ccc;
  display: block;
}
.upload-text {
  font-size: 24rpx;
  color: #999;
}
.hint {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 10rpx;
  display: block;
}
.submit-btn.disabled {
  background-color: #ccc;
}
.verified-tip {
  text-align: center;
  margin-top: 100rpx;
}
.pass {
  color: #07c160;
  font-size: 32rpx;
}