page {
  margin: 0;
  background: #f8f6ff;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  position: relative;
  padding: 64rpx 40rpx 44rpx;
  border-radius: 0 0 56rpx 56rpx;
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 52%, #fbc2eb 100%);
  box-sizing: border-box;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  margin-right: 28rpx;
  background: #e5e7eb;
  flex-shrink: 0;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ec4899;
  font-size: 44rpx;
  font-weight: 700;
}

.name-wrap {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  max-width: 330rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verify-badge {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.28);
}

.bio {
  display: -webkit-box;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 36rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.follow-btn {
  position: absolute;
  right: 40rpx;
  bottom: 36rpx;
  min-width: 132rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #5b8def;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.follow-btn.followed {
  color: #6b7280;
  background: rgba(255, 255, 255, 0.82);
}

.stats-card,
.info-card,
.tag-card {
  margin: 28rpx 30rpx 0;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stats-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.stat-line {
  width: 2rpx;
  height: 54rpx;
  background: #eef0f5;
}

.info-card {
  padding: 8rpx 30rpx;
}

.info-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f3f4f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #6b7280;
}

.info-value {
  max-width: 430rpx;
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-card {
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #edf5ff;
  color: #1e5f9b;
  font-size: 25rpx;
}

.empty-tip {
  color: #9ca3af;
  font-size: 26rpx;
}
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 30rpx;
  margin: 28rpx 30rpx 0;
  padding: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 25rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #a1c4fd, #fbc2eb);
  color: #fff;
  font-weight: bold;
}

.list-container {
  margin: 30rpx;
}

.post-card {
  background: #fff;
  border-radius: 25rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 15rpx rgba(0,0,0,0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.tag,
.status {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #edf5ff;
  color: #1e5f9b;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 18rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  color: #999;
  font-size: 24rpx;
}
