/* 全局背景 跟随你主题 */
page {
  background-color: #F8F9FF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  padding-bottom: 120rpx;
}
.page-wrap {
  padding: 30rpx;
}

/* 用户信息区 仿QQ空间 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.avatar-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.grid-item video {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.empty-comment {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.user-right {
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #1F2937;
}
.publish-time {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 动态标题 */
.moment-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1F2937;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 动态正文 */
.moment-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* 动态图片 */
.moment-img {
  margin-bottom: 24rpx;
}
.moment-img image {
  width: 100%;
  border-radius: 16rpx;
}

/* 标签 + 地点 */
.moment-tag-location {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.tag-item {
  padding: 8rpx 20rpx;
  background-color: #E8F3FF;
  color: #63A4FF;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.location-txt {
  font-size: 24rpx;
  color: #6B7280;
}

/* QQ空间 点赞评论浏览工具栏 */
.tool-bar {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(165,216,255,0.1);
  margin-bottom: 30rpx;
}
.tool-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.tool-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.num {
  font-size: 26rpx;
  color: #6B7280;
}


/* 分割线 */
.line {
  height: 1rpx;
  background-color: #E5E7EB;
  margin: 20rpx 0;
}

/* 评论区 */
.comment-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
  margin-bottom: 24rpx;
}
.comment-item {
  display: flex;
  margin-bottom: 30rpx;
}
.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: #A5D8FF;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.comment-right {
  flex: 1;
}
.cmt-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}
.cmt-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin: 8rpx 0;
}
.cmt-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 底部固定评论输入栏 仿QQ空间 */
.input-fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-top: 1rpx solid #eee;
  box-sizing: border-box;
}
.cmt-input {
  flex: 1;
  height: 70rpx;
  background-color: #F5F7FA;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  min-width: 0;
}
.send-btn {
  width: 125rpx;          /* 固定宽度 */
  height: 70rpx;
  margin-left: 20rpx;
  border-radius: 35rpx;
  background: linear-gradient(135deg, #A5D8FF, #FFB6C1);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  flex-shrink: 0;
}
/* 图片九宫格布局 仿QQ空间 */
.moment-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  overflow: hidden;
}
.grid-item image {
  width: 100%;
  height: 100%;
}